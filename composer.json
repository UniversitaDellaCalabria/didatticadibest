{
    "name": "dibest/didattica",
    "description": "Portale Didattica DiBEST (Università della Calabria): migrazione graduale a classi PSR-4 (vedi MIGRATION_PLAN.md)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.12"
        },
        "platform-check": false,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "phpunit",
            "php strumenti/prove/esegui.php"
        ],
        "inventario": "php strumenti/inventario_oop.php",
        "cs": "php-cs-fixer fix",
        "cs-verifica": "php-cs-fixer fix --dry-run --diff",
        "stan": "php phpstan.phar analyse"
    }
}
