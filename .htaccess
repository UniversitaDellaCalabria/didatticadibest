Options -Indexes -MultiViews

<Files "config.php">
    Require all denied
</Files>
<Files "functions.php">
    Require all denied
</Files>
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
# Composer e PHPUnit (migrazione a classi, vedi MIGRATION_PLAN.md): configurazioni non pubbliche
<FilesMatch "^(composer\.(json|lock)|phpunit\.xml(\.dist)?)$">
    Require all denied
</FilesMatch>

# Blocca l'accesso diretto a file di backup/temporanei che possono contenere
# codice sorgente o credenziali (es. index.php.save, functions.php.save)
<FilesMatch "\.(save|bak|old|orig|swp|sql|log)(\.\d+)?$">
    Require all denied
</FilesMatch>
# Archivi (es. aggiornamento.tgz caricato per gli aggiornamenti: contiene il codice) e documenti interni (README, piano di migrazione)
<FilesMatch "\.(tgz|tar|gz|zip|7z|rar|md)$">
    Require all denied
</FilesMatch>

# Pagine e file di testo compressi (da 3 a 4 volte più leggeri); se il modulo non c'è, non succede niente
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
# Librerie e foto della home: il nome cambia quando cambia il contenuto, quindi il browser può tenerli a lungo (la regola che imposta LUNGA è più sotto).
# Il resto di CSS, JS e immagini si ricontrolla ogni giorno.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
    ExpiresByType image/png "access plus 1 day"
    ExpiresByType image/jpeg "access plus 1 day"
    ExpiresByType image/webp "access plus 1 day"
    ExpiresByType image/svg+xml "access plus 1 day"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=LUNGA
</IfModule>

RewriteEngine On
RewriteRule ^(assets/vendor|uploads/slide_home)/ - [E=LUNGA:1]
# Librerie di Composer (vendor/, solo in sviluppo): mai raggiungibili dal web (src/ e tests/ hanno il loro .htaccess)
RewriteRule (^|/)vendor/ - [F,L]
# Nessun RewriteBase: le regole valgono qualunque sia la cartella del portale (/didattica, /eventi…)

# =========================================================================
# 0. SCUDO CARTELLA ADMIN: Lascia funzionare il backend normalmente!
# =========================================================================
# Se la richiesta è dentro admin/ e omette il .php, glielo aggiunge
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(admin/.*)$ $1.php [NC,QSA,L]

# Se la richiesta è dentro admin/, fermati qui e non leggere le regole sotto
RewriteRule ^admin(/|$) - [NC,L]
# =========================================================================

# 1. SE IL FILE O LA CARTELLA ESISTE FISICAMENTE, FERMATI QUI E CARICALO
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. SE MANCA L'ESTENSIONE MA IL FILE PHP ESISTE (Es: /area_personale)
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [QSA,L]

# 4. MOTORE DINAMICO CON .PHP
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)\.php$ area.php?slug=$1 [QSA,L]

# (Opzionale) Manteniamo attiva anche la versione senza estensione
# nel caso qualcuno avesse salvato il link vecchio
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_-]+)/?$ area.php?slug=$1 [QSA,L]
